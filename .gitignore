# =========================
# RevenueGuard Root Gitignore
# =========================

# Dependencies
node_modules/
.gemini/

# Environment Variables
.env
.env.local
.env.production
.env.*

# Build output (Client & Server)
dist/
dist-ssr/
build/
client/dist/
server/dist/

# Python / FastAPI (Server)
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
server/venv/

# Node & JS Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & OS Files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
